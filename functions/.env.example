# Never commit functions/.env. Copy this file to functions/.env for local use.
ALLOWED_TTS_UIDS=replace-with-your-firebase-uid
ALLOWED_ORIGINS=https://punjabi.dockit.co.nz,http://localhost:8000

TTS_LANGUAGE=pa-IN
TTS_SPEAKING_RATE=1.0
TTS_SLOW_SPEAKING_RATE=0.70
TTS_PITCH=0
TTS_CACHE_VERSION=pa-IN-gender-v2

MAX_TTS_TEXT_LENGTH=500
MAX_TTS_REQUESTS_PER_MINUTE=10
MAX_TTS_CHARACTERS_PER_DAY=5000
MAX_TTS_CHARACTERS_PER_MONTH=50000

# "memory" is convenient for local testing, but is per function instance.
# Use "firestore" before a multi-instance production deployment.
TTS_USAGE_STORE=memory
TTS_MEMORY_CACHE_ITEMS=100
